# Sahal Frontend Environment
# انسخ هذا الملف إلى .env واضبط المتغيرات

# عنوان الخادم الخلفي (Backend)
REACT_APP_BACKEND_URL=http://localhost:8004

# WebSocket URL (يُشتق تلقائياً من BACKEND_URL إذا تُرك فارغاً)
# Production: ws تُستبدل بـ wss تلقائياً
# REACT_APP_WS_URL=ws://localhost:8004

# Google OAuth
REACT_APP_GOOGLE_CLIENT_ID=

# Port للـ development server (اختياري)
WDS_SOCKET_PORT=3000
