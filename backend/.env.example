# سهل - Backend Environment Variables
# انسخ هذا الملف إلى .env واملأه بقيمك الحقيقية
# ⚠️ لا ترفع .env إلى GitHub أبداً!

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=sahal_db

# Environment (development | production)
# production: يمنع mock payments، يمنع إعادة رمز إعادة التعيين، يغلق /seed/admin بدون رمز
ENV=development

# Security - مهم: غير هذا في الإنتاج بقيمة عشوائية قوية
# يمكن توليد قيمة قوية بـ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret

# CORS - حدد origins المسموح بها (افصل بفاصلة)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# URLs
# FRONTEND_URL تستخدم لروابط تأكيد بريد إعادة التعيين و QR و Stripe redirects
FRONTEND_URL=http://localhost:3000
# BACKEND_URL = url الخادم في النشر (اختياري في التطوير)
BACKEND_URL=

# Stripe (اختياري في التطوير — إجباري في الإنتاج)
# STRIPE_API_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx (من Stripe Dashboard → Webhooks)
STRIPE_CURRENCY=usd

# Mock payments - اتركه true للتطوير، واجعل التطبيق يفشل بأمان بدون Stripe في الإنتاج
ALLOW_MOCK_PAYMENTS=true

# Admin seeding - /seed/admin مخصص للتطوير
# في الإنتاج: عيّن ADMIN_SETUP_TOKEN ثم مرّره في هيدر X-Admin-Setup-Token
# ADMIN_SETUP_TOKEN=
# ADMIN_INITIAL_PASSWORD=

# AI Chat (اختياري) - Anthropic/Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# SMTP - لإرسال إعادة تعيين كلمة المرور (نوصي Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_EMAIL=
# SMTP_PASSWORD=

# Google OAuth (اختياري)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Web Push (اختياري - يُولَّد تلقائياً ويُحفظ في MongoDB)
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@sahal.com

# Server
PORT=8000